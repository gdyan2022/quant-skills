# Wind 数据库访问配置
# 复制为 .env 后填入真实值（.env 已被 .gitignore 排除）

# ── 数据库连接 ───────────────────────────────────────────
# WIND_DB_DIALECT 同时决定 Python 读数的 SQLAlchemy 方言和 MCP 走哪条路（setup-mcp.sh 自动选）：
#   mssql+pyodbc          ← Wind 官方 SQL Server 版，最常见          → dbhub MCP（dbhub-wind）
#   mysql+pymysql / mariadb+pymysql / postgresql+psycopg2 / sqlite → dbhub MCP（dbhub-wind）
#   oracle+oracledb       ← Wind 官方 Oracle 版                      → FreePeak db-mcp-server（dbmcp-wind）
# 为什么 Oracle 不走 dbhub：dbhub 1.5+ 的 Oracle connector 只有 node-oracledb Thin 模式，
# 要求服务器 ≥ 12.1；Wind 现网大量是 11.2.0.4，会报 NJS-138。FreePeak 用纯 Go 驱动 go-ora，
# 支持 Oracle 10.2+，不需要 Instant Client，自带 read_only / max_rows 护栏。
WIND_DB_DIALECT=mssql+pyodbc
WIND_DB_HOST=db.internal
# 默认端口：mssql 1433 / mysql 3306 / postgres 5432 / oracle 1521
WIND_DB_PORT=1433
WIND_DB_USER=your_user
WIND_DB_PASSWORD=your_password_here
# Oracle 填 service name（如 windb）；老式 SID 见下面 WIND_DB_SID
WIND_DB_NAME=wind

# ── SQL Server 专用（可选）──────────────────────────────
# WIND_DB_SSLMODE：disable（默认，适合内网/自签证书）/ require（强制 TLS）
# WIND_DB_INSTANCE：命名实例名（如 SQLEXPRESS），普通 MSSQL 不用填
# WIND_DB_SSLMODE=disable
# WIND_DB_INSTANCE=

# ── Oracle 专用（可选，dialect=oracle+* 时才生效）────────
# WIND_DB_SCHEMA：Wind 表所在 schema（owner）。Oracle 版 Wind 通常把表建在 WIND 用户下，
#   你登录的是另一个只读账号（如 RWIND），靠同义词访问；同义词不一定覆盖全部表，
#   所以 SQL 里带 WIND. 前缀最稳。留空 = 不加前缀。
# WIND_DB_SID：老式 SID 连接，和 WIND_DB_NAME（service name）二选一；有 service name 就别填
# WIND_ORACLE_CLIENT_LIB_DIR：Oracle Instant Client 目录（python-oracledb thick 模式用）。
#   服务器是 11g 时 Python 读数必须填（thin 模式连 11g 报 DPY-3010）；服务器 ≥ 12.1 可留空。
#   macOS ARM64 免登录下载（Basic Light，48MB）：
#   https://download.oracle.com/otn_software/mac/instantclient/instantclient-basiclite-macos-arm64.dmg
#   挂载后把全部文件拷到一个固定目录即可，例如 ~/.local/opt/instantclient_23_3
# WIND_DBMCP_VERSION：FreePeak db-mcp-server 的 release 版本（setup-mcp.sh 下载预编译二进制用），默认 v1.14.0
# WIND_DBMCP_BIN：已有二进制（比如 go install 装的）时直接指定路径，跳过下载
# WIND_DBMCP_READ_ONLY：FreePeak 的引擎级只读护栏，默认 true。它在启动时审计账号权限，
#   账号若持有 CREATE TABLE 等任一写权限就拒绝启动（setup-mcp.sh 会试启动并提示）。
#   此时要么让 DBA 收回写权限，要么显式设 false 关掉护栏、改靠 skill 纪律，
#   并建议在 Claude Code 的 permissions.deny 里禁掉 mcp__dbmcp-wind__execute_wind / transaction_wind。
# WIND_DB_SCHEMA=WIND
# WIND_DB_SID=
# WIND_ORACLE_CLIENT_LIB_DIR=
# WIND_DBMCP_VERSION=v1.14.0
# WIND_DBMCP_BIN=
# WIND_DBMCP_READ_ONLY=true

# ── 数据字典（在线版，默认 fallback）────────────────────
# URL 可以用默认，用户/密码必须向站点管理员索取（无通用默认值）
WIND_DICT_URL=https://winddict.081188.xyz
WIND_DICT_USER=
WIND_DICT_PASS=

# ── 数据字典（本地版，可选但强烈推荐）───────────────────
# 指向克隆到本地的 wind_data_dict/ 目录，dict.sh 会优先走本地 grep
# 例：
#   WIND_DICT_LOCAL=/Users/gdyan/workspace/claude/wind-data-dict/wind_data_dict
WIND_DICT_LOCAL=

# ── 列表模式过滤 ────────────────────────────────────────
# dict.sh -l 默认只输出这五个库的表，适合常见订阅场景。
# 留空 = 输出全部 25 个库（共 2657 张）。
# 库名必须和字典里第一级目录完全一致，逗号分隔。
WIND_LIST_DBS=基础代码表,中国A股数据库,中国香港股票数据库,中国共同基金数据库,指数数据库
